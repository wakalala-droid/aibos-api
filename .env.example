# ── AI-BOS FastAPI Backend — Environment Variables ──────────────────
# Copy this to .env (Railway sets these in the Variables dashboard)

# Groq — your existing key from the Streamlit app
GROQ_API_KEY=gsk_your_key_here
# Vision model for receipt OCR (/ingest/receipt). Override if Groq renames it.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Supabase — use the SERVICE KEY (not anon key) for server-side access.
# Required for the Evolution spine (Business Events + Digital Twin). Without these
# the /events and /twin endpoints return 503; file-analysis endpoints still work.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key_here

# Optional: enables fast LOCAL JWT verification (auth.py). Find it at
# Supabase → Project Settings → API → JWT Settings → JWT Secret. When unset, the
# backend verifies tokens via supabase.auth.get_user() instead (no extra config).
SUPABASE_JWT_SECRET=

# Your Vercel frontend URL — for CORS whitelist
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# CORS allowlist — comma-separated web origins allowed to call this API from a
# browser. REQUIRED in production; if unset it defaults to localhost:3000 (dev
# only). Browsers otherwise reach the API only via the Next /api/proxy (server
# to server, no CORS). e.g. https://app.aibos.africa,https://aibos.vercel.app
ALLOWED_ORIGINS=

# Max accepted upload size in bytes (default 15 MB). Guards the in-memory cabinet
# against memory-exhaustion DoS.
MAX_UPLOAD_BYTES=15728640

# Email (optional — only if using send_report_email)
ADMIN_EMAILS=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_password_here

# ── Mobile Money payments (optional) ────────────────────────────────
# Leave UNSET to run checkout in simulation mode (dev). Set after merchant
# onboarding to go live — no frontend changes needed.

# MTN MoMo Collections
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# Airtel Money Collections
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_COUNTRY=ZM

# Dev-only: set true to let checkout SIMULATE a successful payment when no
# provider keys are set. MUST stay unset/false in production, otherwise anyone
# could "pay" for free. Real keys above always take precedence over simulation.
PAYMENTS_SIMULATION=false
# Seconds before a SIMULATED payment reports success (dev only)
PAYMENTS_SIM_DELAY=6

# Shared secret the mobile-money provider must send on the webhook
# (X-Callback-Secret header) for /payments/callback/{network}. REQUIRED for the
# callback to do anything — if unset, every callback is rejected (403), so no
# anonymous POST can mark a payment successful and grant a tier. Set this to a
# long random string and configure the same value in the provider's webhook.
PAYMENTS_CALLBACK_SECRET=
# ── Morning Brief delivery (notify.py) — ready-for-keys ──────────────────────
# Email via Resend (https://resend.com — free tier is enough to start).
RESEND_API_KEY=
# Verified sender. Until your domain is verified in Resend, leave unset to use
# their test sender (delivers to your own account only).
BRIEF_FROM_EMAIL=
# WhatsApp via Meta Cloud API (https://developers.facebook.com/docs/whatsapp).
# Business-initiated daily messages need an APPROVED template — put its name in
# WHATSAPP_TEMPLATE (single {{1}} body parameter). Without a template, sends are
# free-form text and only deliver inside a 24h window after the user last
# messaged your number.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
# Shared secret for POST /notify/dispatch-briefs (X-Cron-Secret header).
# REQUIRED — if unset, dispatch is rejected, so nobody can trigger a mass send.
CRON_SECRET=
